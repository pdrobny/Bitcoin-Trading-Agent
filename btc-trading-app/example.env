ALPACA_API_KEY=<insert your Alpaca API key here>
ALPACA_API_SECRET=<insert your Alpaca API secret here>
ALPACA_PAPER=true

# Trading (adjust as needed for your risk tolerance and preferences)
SYMBOL=BTC/USD
LOCAL_TZ=America/Phoenix
FEE_BUFFER_PCT=0.001
SLEEP_SEC=15
LOOKBACK_BARS=600
NOTIONAL_SAFETY_PCT=0.001
NOTIONAL_SAFETY_USD=25
RETRY_BACKOFF_PCT=0.005
RETRY_MAX_ATTEMPTS=3


# Gemini LLM settings
USE_GEMINI=true
GEMINI_API_KEY=<insert your Gemini API key here>
GEMINI_API_SECRET=<insert your Gemini API secret here>
    # Choose your Gemini model (options: gemini-1.5-flash-lite, gemini-2.0-flash-lite)
GEMINI_MODEL=gemini-2.0-flash-lite
    # Use trade_decider=rules for simple rules-based trading, llm for LLM-based trading)
TRADE_DECIDER=llm

# EOD email via Gmail (App Password required)
GMAIL_ADDRESS=<insert your Gmail address here>
GMAIL_APP_PASSWORD=<insert your Gmail App Password here, this not your regular login password>
EOD_TO_EMAILS=<insert comma-separated list of recipient email addresses here>

# Data directory
DATA_DIR=data